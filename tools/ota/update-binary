#!/sbin/sh
# ReCore delta OTA installer. Runs inside TWRP. Rebuilds the new super.img from the installed super partition
# plus the patch in this zip, checks it, then writes it. Nothing is written to a partition before the check passes.

OUTFD=$2
ZIP=$3

ui_print() {
    echo "ui_print $1" >> /proc/self/fd/$OUTFD
    echo "ui_print" >> /proc/self/fd/$OUTFD
}
abort() {
    ui_print " "
    ui_print "ERROR: $1"
    ui_print "Nothing was changed. If the problem continues, flash the full ROM zip."
    rm -rf "$TMP" "$IMG"
    exit 1
}

TMP=${RCOTA_TMP:-/tmp/rcota}
BLOCKDIRS=${RCOTA_BLOCKDIRS:-"/dev/block/by-name /dev/block/bootdevice/by-name /dev/block/platform/*/by-name"}
IMG=${RCOTA_TMPIMG:-/data/media/0/.rcota_super.tmp}
DATADIR=$(dirname "$IMG")

rm -rf "$TMP"
mkdir -p "$TMP"
ui_print " "
ui_print "ReCore update"
unzip -o "$ZIP" -d "$TMP" > /dev/null 2>&1 || abort "Could not unpack the update."
[ -f "$TMP/manifest.sh" ] || abort "The update is incomplete."
. "$TMP/manifest.sh"
chmod 755 "$TMP/rcdelta"

# No device-name check: the objective name is not always ro.product.device. Safety comes from rcdelta,
# which checks every chunk of the installed system against the base build of this update before writing anything.
ui_print "Updating build $FROM_BUILD to $TO_BUILD ($CHANNEL)"

find_block() {
    for d in $BLOCKDIRS; do
        if [ -e "$d/$1" ]; then
            readlink -f "$d/$1"
            return 0
        fi
    done
    return 1
}
SUPER=$(find_block super) || abort "Could not find the super partition."

NEED_KB=$(( (NEW_SIZE + 1073741824) / 1024 ))
FREE_KB=$(df -Pk "$DATADIR" 2>/dev/null | awk 'NR==2 {print $4}')
if [ -z "$FREE_KB" ] || [ "$FREE_KB" -lt "$NEED_KB" ]; then
    abort "Not enough free storage. Free up about $((NEED_KB / 1048576)) GB of internal storage and try again."
fi

ui_print "Preparing the new system (this takes a few minutes)..."
"$TMP/rcdelta" apply "$SUPER" "$TMP/super.patch" "$IMG" > "$TMP/apply.log" 2>&1 &
PID=$!
LAST=""
while kill -0 $PID 2> /dev/null; do
    L=$(tail -n 1 "$TMP/apply.log" 2> /dev/null)
    if [ -n "$L" ] && [ "$L" != "$LAST" ]; then
        ui_print "  $L"
        LAST="$L"
    fi
    sleep 5
done
wait $PID || abort "$(tail -n 1 "$TMP/apply.log")"
ui_print "New system verified."

umount /system_root /system /vendor /product /odm /system_ext /vendor_dlkm /odm_dlkm 2> /dev/null

ui_print "Writing the new system..."
dd if="$IMG" of="$SUPER" bs=4194304 > "$TMP/dd.log" 2>&1 || abort "Writing the super partition failed. Flash the full ROM zip now."
sync

GOT=$("$TMP/rcdelta" hash "$SUPER" "$NEW_SIZE")
if [ "$GOT" != "$NEW_SHA" ]; then
    ui_print "WARNING: the written system does not match. Flash the full ROM zip before rebooting."
    rm -f "$IMG"
    exit 1
fi
rm -f "$IMG"

for f in $IMAGES; do
    P=$(find_block "${f%.img}") || abort "Could not find the ${f%.img} partition."
    ui_print "Writing $f"
    dd if="$TMP/$f" of="$P" bs=4194304 > /dev/null 2>&1 || abort "Writing $f failed. Flash the full ROM zip now."
done
sync

rm -rf "$TMP"
ui_print " "
ui_print "Update installed."
exit 0
